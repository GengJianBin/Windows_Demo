{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "Node16",
    "moduleResolution": "Node16",
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "outDir": "./dist-main",
    "rootDir": "./"
  },
  "include": ["main/**/*", "types/**/*"],
  "exclude": ["node_modules", "src", "dist", "dist-main"]
}
